{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Cenit Lab",
  "version": "1.0.0",
  "color": {
    "indigo":      { "value": "#0D1430", "name": "Índigo Cenit",   "role": "Primario · superficies, texto" },
    "indigoDeep2": { "value": "#16204A", "name": "Índigo Profundo", "role": "Degradados, profundidad" },
    "indigoDeep":  { "value": "#0B1026", "name": "Índigo Deep",     "role": "Fondo más oscuro" },
    "gold":        { "value": "#C6A35B", "name": "Oro Cenit",       "role": "Acento cálido · lo humano" },
    "goldLight":   { "value": "#D8B86E", "name": "Oro claro",       "role": "Trazo humano sobre oscuro / brillos" },
    "goldDeep":    { "value": "#7E5F1E", "name": "Oro profundo",    "role": "Eyebrows/labels sobre claro · AA (antes #A8843B = 3.1:1)" },
    "steel":       { "value": "#8FA8CE", "name": "Azul Estelar",    "role": "Acento frío · la máquina" },
    "steelLight":  { "value": "#A6BEDE", "name": "Azul claro",      "role": "Trazo máquina sobre oscuro" },
    "bone":        { "value": "#F4F1E9", "name": "Hueso",           "role": "Fondo claro, texto invertido" },
    "bone2":       { "value": "#FBF9F3", "name": "Hueso 2",         "role": "Fondo claro alterno" },
    "ink":         { "value": "#15192B", "name": "Tinta",           "role": "Texto cuerpo sobre claro" },
    "mist":        { "value": "#565D6E", "name": "Niebla",          "role": "Texto secundario sobre claro · AA 5.8:1 (antes #6B7385 = 4.2:1)" },
    "mistDark":    { "value": "#AEB6C7", "name": "Niebla clara",     "role": "Texto secundario sobre oscuro · AA ~6.8:1" },
    "line":        { "value": "#E3DDD1", "name": "Línea",           "role": "Bordes / hairlines sobre claro" }
  },
  "typography": {
    "display": { "family": "Space Grotesk", "weights": [400,500,600,700], "use": "Titulares, wordmark", "headingWeight": 600 },
    "body":    { "family": "IBM Plex Sans", "weights": [300,400,500,600], "use": "Cuerpo, interfaz", "bodyWeight": 300, "emphasisWeight": 500 },
    "mono":    { "family": "IBM Plex Mono", "weights": [400,500], "use": "Datos, etiquetas, código", "transform": "uppercase", "tracking": "0.2em" }
  },
  "wordmark": {
    "text": "CENIT LAB",
    "family": "Space Grotesk",
    "weight": 600,
    "case": "uppercase",
    "letterSpacing": "0.06em",
    "accentWord": "LAB",
    "accentColorOnLight": "#C6A35B",
    "accentColorOnDark": "#D8B86E"
  },
  "isotype": {
    "viewBox": "0 0 120 120",
    "strokeWidth": 7.5,
    "strokeLinecap": "round",
    "humanStroke": { "path": "M28 98 C 33 54, 50 30, 60 22", "color": "#C6A35B", "colorOnDark": "#D8B86E", "meaning": "lo humano" },
    "machineStroke": { "path": "M92 98 C 87 54, 70 30, 60 22", "color": "#8FA8CE", "colorOnDark": "#A6BEDE", "meaning": "la máquina" },
    "zenithPoint": { "shape": "circle", "cx": 60, "cy": 20, "r": 6, "fill": "linear-gradient #D8B86E -> #A6BEDE", "meaning": "la fusión / punto más alto" },
    "halo": { "shape": "circle", "cx": 60, "cy": 20, "r": 10.5, "stroke": "#C6A35B", "strokeWidth": 1.4, "opacity": 0.4 },
    "glint": { "shape": "circle", "cx": 58, "cy": 18, "r": 1.8, "fill": "#FBF6EA", "opacity": 0.9 },
    "glow": { "shape": "circle", "cx": 60, "cy": 20, "r": 18, "fill": "radial #C6A35B 0.4 -> 0" }
  },
  "units": [
    { "code": "CL · AI", "name": "Cenit Lab AI", "focus": "Agentes, LLMs, Machine Learning, Automation" },
    { "code": "CL · DT", "name": "Cenit Lab Data", "focus": "Data platforms, Analytics, Warehousing, BI" },
    { "code": "CL · SY", "name": "Cenit Lab Systems", "focus": "Software, Apps, Integraciones, APIs, Infraestructura" },
    { "code": "CL · XP", "name": "Cenit Lab Experience", "focus": "Customer Experience, Hospitality Tech, AI Interfaces" },
    { "code": "CL · VN", "name": "Cenit Lab Ventures", "focus": "Incubación y creación de startups propias" }
  ]
}
